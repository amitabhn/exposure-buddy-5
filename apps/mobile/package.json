{
  "name": "exposure-buddy-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src --ext .ts,.tsx",
    "test": "jest",
    "eas-build-post-install": "cd ../.. && pnpm turbo run build --filter=@exposure-buddy/core --filter=@exposure-buddy/supabase --filter=@exposure-buddy/sync --filter=@exposure-buddy/ui"
  },
  "jest": {
    "preset": "jest-expo",
    "resolver": "react-native-worklets/jest/resolver.js",
    "moduleNameMapper": {
      "^react-native-safe-area-context$": "<rootDir>/__mocks__/react-native-safe-area-context.ts",
      "^react-native$": "<rootDir>/node_modules/react-native"
    }
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@journeyapps/react-native-quick-sqlite"
        ]
      }
    }
  },
  "dependencies": {
    "@expo-google-fonts/dm-serif-display": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@exposure-buddy/core": "workspace:*",
    "@exposure-buddy/supabase": "workspace:*",
    "@exposure-buddy/sync": "workspace:*",
    "@exposure-buddy/ui": "workspace:*",
    "@journeyapps/react-native-quick-sqlite": "^2.5.2",
    "@react-native-community/datetimepicker": "9.1.0",
    "@rn-primitives/portal": "1.4.0",
    "@sentry/react-native": "~7.11.0",
    "expo": "~57.0.25",
    "expo-application": "~57.0.3",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "^57.0.19",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-localization": "^57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.23",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "i18next": "^26.2.0",
    "react": "19.2.3",
    "react-i18next": "^17.0.8",
    "react-native": "0.86.3",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-worklets": "~0.10.1",
    "tslib": "^2.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@expo/config-plugins": "~57.0.9",
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^29.0.0",
    "@types/react": "~19.2.18",
    "@typescript-eslint/parser": "^8.59.4",
    "babel-preset-expo": "~57.0.13",
    "eslint": "^8.57.1",
    "eslint-plugin-i18next": "^6.1.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  }
}
