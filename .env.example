# NEVER commit real values to this file or any other committed file.
#
# For the mobile app (Expo) — set as EAS env vars with `EXPO_PUBLIC_` prefix so
# Expo inlines them into the JS bundle at build time:
#   eas env:create --name EXPO_PUBLIC_SUPABASE_URL --value <url> --environment preview --visibility plaintext
#   eas env:create --name EXPO_PUBLIC_SUPABASE_ANON_KEY --value <key> --environment preview --visibility sensitive
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SENTRY_DSN=

# For Node-side RLS integration tests (packages/supabase/__tests__/rls/*). Loaded
# from a local .env file via dotenv — NOT bundled into the app.
SUPABASE_URL=
SUPABASE_ANON_KEY=
